# ---------------------------------------------------------------------------
# Food Scanner website — environment variables
# Copy this file to `.env.local` and fill in the values you need.
# All variables are OPTIONAL. With none set, waitlist signups are saved to a
# local file (data/waitlist.json) — fine for development, but NOT for
# serverless hosting like Vercel (read-only filesystem).
# ---------------------------------------------------------------------------

# Public site URL — used for SEO metadata, sitemap, and robots.txt.
# Set this to your real domain in production.
NEXT_PUBLIC_SITE_URL=https://foodscanner.app

# --- Waitlist storage (choose ONE for production) --------------------------

# Option A: Generic webhook. Works with a Google Sheets Apps Script,
# Zapier, Make, or any endpoint that accepts a JSON POST { email, joinedAt }.
# WAITLIST_WEBHOOK_URL=https://script.google.com/macros/s/xxx/exec

# Option B: Resend Audiences (https://resend.com). Create an audience and API key.
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_AUDIENCE_ID=00000000-0000-0000-0000-000000000000
